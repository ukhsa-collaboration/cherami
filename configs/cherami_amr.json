{
  "global": {
    "work_dir": "/shared/team/projects/downstream_orchestration/work",
    "output_dir": "/shared/team/projects/downstream_orchestration/output"
  },
  "pipeline": {
    "name": "amr",
    "version": "0.1.0",
    "path": "/shared/team/projects/downstream_orchestration/gpha-mscape-nf-amr",
    "cpus": 4,
    "mem": "8G",
    "cpu_limit": 4,
    "mem_limit": "8G",
    "nf_config_path": "/shared/team/projects/downstream_orchestration/gpha-mscape-nf-amr/nextflow.config",
    "nf_profiles": [
      "docker"
    ],
    "nf_extra_args": [],
    "namespace": "ns-synthscape-ukhsa",
    "container": "quay.io/climb-tre/nextflow",
    "backoff_limit": 5,
    "max_retries": 1,
    "retry_timeout": 10,
    "job_timeout": 3600
  },
  "worker": {
    "listen_exchange": "cherami_test",
    "listen_queue_suffix": "amr_pipeline",
    "publish_queue_suffix": null,
    "publish_exchange": null,
    "varys_config_path": "./conf/varys.cfg",
    "varys_log_path": "./amr_varys.log"
  }
}
